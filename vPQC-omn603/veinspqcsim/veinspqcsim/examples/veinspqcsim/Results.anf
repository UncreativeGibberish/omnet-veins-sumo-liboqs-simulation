        </chart>
        <chart icon="icons/full/obj/barchart.png" id="1493034202" name="networkdelay v2v" template="barchart_mpl" type="MATPLOTLIB">
            <script><![CDATA[from omnetpp.scave import results, chart, utils
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt

# get chart properties
props = chart.get_properties()
utils.preconfigure_plot(props)

# collect parameters for query
filter_expression = props["filter"]
include_fields = props["include_fields"] == "true"

# query scalar data into dataframe
try:
    df = results.get_scalars(
        filter_expression,
        include_fields=include_fields,
        include_attrs=True,
        include_runattrs=True,
        include_itervars=True,
    )
except results.ResultQueryError as e:
    raise chart.ChartScriptError("Error while querying results: " + str(e))

if df.empty:
    raise chart.ChartScriptError("The result filter returned no data.")

if "configname" not in df.columns:
    raise chart.ChartScriptError(
        "Column 'configname' is missing. Make sure include_runattrs=True."
    )

# --- grouping: x-axis = config name, series = result name ---
# Override the default (module, name) partitioning.
groups = ["configname"]
series = ["name"]

# If you also want to split series by module, use:
# series = ["name", "module"]

confidence_level = None  # we use stddev instead of a confidence interval

# Mean and std across runs / repetitions of each config
stats = (
    df.groupby(groups + series, dropna=False)["value"]
      .agg(mean="mean", std="std", count="count")
      .reset_index()
)

print("Mean and standard deviation by configuration:")
print(stats.to_string(index=False))
print()

# Pivot into the shape expected by utils.plot_bars():
#   valuedf  rows = series, columns = groups (confignames)
#   errorsdf same shape, values = standard deviation
valuedf = stats.pivot_table(index=series, columns=groups, values="mean", dropna=False)
errorsdf = stats.pivot_table(index=series, columns=groups, values="std", dropna=False)

# A single run per config yields NaN std; treat that as 0 so bars still draw
errorsdf = errorsdf.fillna(0.0)

# Metadata frame used for titles / units / legend
metadf = stats.set_index(series)
# keep one metadata row per series (first config is enough)
metadf = metadf[~metadf.index.duplicated(keep="first")]

# Attach unit/title from the original result rows when available
for col in ("unit", "title", "module"):
    if col in df.columns:
        extra = df.groupby(series)[col].agg(
            lambda s: s.dropna().iloc[0] if s.dropna().size else ""
        )
        metadf[col] = extra

utils.plot_bars(valuedf, errorsdf, metadf, props)

# Optional: print mean ± std on top of each bar (matplotlib charts only)
try:
    ax = plt.gca()
    # Walk bar containers in the same row-major order as valuedf
    means = valuedf.to_numpy()
    stds = errorsdf.to_numpy()
    containers = [c for c in ax.containers if hasattr(c, "patches")]
    for row_i, container in enumerate(containers):
        if row_i >= means.shape[0]:
            break
        for col_i, bar in enumerate(container.patches):
            if col_i >= means.shape[1]:
                break
            m = means[row_i, col_i]
            s = stds[row_i, col_i]
            if pd.isna(m):
                continue
            ax.text(
                bar.get_x() + bar.get_width() / 2.0,
                bar.get_height() + (s if pd.notna(s) else 0.0),
                f"{m:.3g}±{s:.3g}",
                ha="center",
                va="bottom",
                fontsize=8,
                rotation=0,
            )
except Exception:
    pass  # skip annotations if the native plot widget is used

utils.postconfigure_plot(props)

utils.export_image_if_needed(props)
utils.export_data_if_needed(df, props)]]></script>
            <dialogPage id="INPUT" label="Input"><![CDATA[<?xml version="1.0" encoding="UTF-8"?>
<xswt xmlns:x="http://sweet_swt.sf.net/xswt">
  <import xmlns="http://sweet_swt.sf.net/xswt">
    <package name="java.lang" />
    <package name="org.eclipse.swt.widgets" />
    <package name="org.eclipse.swt.graphics" />
    <package name="org.eclipse.swt.layout" />
    <package name="org.eclipse.swt.custom" />
  </import>
  <layout x:class="GridLayout" numColumns="2" />
  <x:children>
    <label text="Filter expression:" >
        <layoutData x:class="GridData" horizontalSpan="2" horizontalAlignment="FILL" grabExcessHorizontalSpace="true"/>
    </label>

    <styledText x:id="filter" x:style="BORDER|V_SCROLL|H_SCROLL" x:id.contentAssist="filter" x:id.resultType="scalar">
      <layoutData x:class="GridData" horizontalSpan="2" horizontalAlignment="FILL" grabExcessHorizontalSpace="true" verticalAlignment="FILL" grabExcessVerticalSpace="true" />
    </styledText>
    
    <button x:id="include_fields" x:style="CHECK" text="Include fields">
      <layoutData x:class="GridData" horizontalAlignment="END" />
    </button>
    
    <button x:id="simplify" x:style="PUSH" text="Simplify" x:id.role="simplify" x:id.targetControl="filter">
      <layoutData x:class="GridData" horizontalAlignment="END" />
    </button>

    <label text="Multiple attributes can be selected in both fields below, separated by commas.">
        <layoutData x:class="GridData" horizontalSpan="2" horizontalAlignment="FILL" grabExcessHorizontalSpace="true"/>
    </label>

    <label text="Groups:"/>
    <combo x:id="groups" x:style="BORDER" x:id.content="module,name,experiment,module+name,$itervarnames,$runattrnames">
        <layoutData x:class="GridData" horizontalAlignment="FILL" grabExcessHorizontalSpace="true"/>
    </combo>

    <label text="Series:"/>
    <combo x:id="series" x:style="BORDER" x:id.content="module,name,experiment,module+name,$itervarnames,$runattrnames">
        <layoutData x:class="GridData" horizontalAlignment="FILL" grabExcessHorizontalSpace="true"/>
    </combo>

    <label text="Scalar values will be averaged across all attributes not selected above.">
        <layoutData x:class="GridData" horizontalSpan="2" horizontalAlignment="FILL" grabExcessHorizontalSpace="true"/>
    </label>

  </x:children>
</xswt>
]]></dialogPage>
            <dialogPage id="BARS" label="Bars"><![CDATA[<?xml version="1.0" encoding="UTF-8"?>
<xswt xmlns:x="http://sweet_swt.sf.net/xswt">

  <import xmlns="http://sweet_swt.sf.net/xswt">
    <package name="java.lang"/>
    <package name="org.eclipse.swt.widgets" />
    <package name="org.eclipse.swt.graphics" />
    <package name="org.eclipse.swt.layout" />
    <package name="org.eclipse.swt.custom" />
    <package name="org.omnetpp.common.wizard.support" />
    <package name="org.omnetpp.ned.editor.wizards.support" />
    <package name="org.omnetpp.cdt.wizard.support" />
  </import>
  <layout x:class="GridLayout"/>

  <x:children>

    <group text="Bars">
      <layoutData x:class="GridData" horizontalSpan="1" horizontalAlignment="FILL" grabExcessHorizontalSpace="true" verticalAlignment="FILL" grabExcessVerticalSpace="false"/>
      <layout x:class="GridLayout" numColumns="2"/>
      <x:children>

        <!-- Baseline -->
        <label text="Baseline:"/>
        <text x:id="baseline" x:id.default="0" x:style="BORDER">
          <layoutData x:class="GridData" horizontalAlignment="FILL" grabExcessHorizontalSpace="true"/>
        </text>

        <!-- Bar placement:Aligned/Overlap/InFront/Stacked -->
        <label text="Bar placement:"/>
        <combo x:id="bar_placement" x:id.default="Aligned" x:style="BORDER|READ_ONLY">
          <add x:p0="Aligned"/>
          <add x:p0="Overlap"/>
          <add x:p0="InFront"/>
          <add x:p0="Stacked"/>
        </combo>

        <!-- Rotate X labels by:0/30/45/60/90 -->
        <label text="Rotate x labels by:"/>
        <combo x:id="xlabel_rotation" x:id.default="0" x:style="BORDER|READ_ONLY">
          <add x:p0="0"/>
          <add x:p0="30"/>
          <add x:p0="45"/>
          <add x:p0="60"/>
          <add x:p0="90"/>
        </combo>

      </x:children>
    </group>

  </x:children>
</xswt>
]]></dialogPage>
