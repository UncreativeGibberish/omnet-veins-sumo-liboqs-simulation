            <property name="title" value="V2I EndToEnd Delay"/>
            <property name="legend_automatic" value="true"/>
            <property name="cycle_seed" value="0"/>
            <property name="bar_placement" value="Aligned"/>
            <property name="yaxis_log" value="false"/>
