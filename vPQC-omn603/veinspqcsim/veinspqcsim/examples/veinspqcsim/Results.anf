            <property name="groups" value=""/>
            <property name="yaxis_min" value=""/>
            <property name="baseline" value="0"/>
            <property name="image_export_filename" value=""/>
            <property name="matplotlibrc.axes.facecolor" value=""/>
            <property name="cap_size" value="4"/>
            <property name="legend_format" value=""/>
            <property name="filter" value="type =~ scalar AND name =~ rsuEndToEndDelay:mean"/>
            <property name="series" value=""/>
            <property name="plt.style" value="default"/>
            <property name="legend_show" value="true"/>
            <property name="matplotlibrc.legend.shadow" value="false"/>
            <property name="include_fields" value="true"/>
            <property name="simplify" value=""/>
            <property name="yaxis_max" value=""/>
            <property name="image_export_width" value="6"/>
            <property name="matplotlibrc" value=""/>
        </chart>
        <chart icon="icons/full/obj/barchart.png" id="605264575" name="Packet Reception Outcome Breakdown" template="barchart_mpl" type="MATPLOTLIB">
            <script><![CDATA[from omnetpp.scave import results, chart, utils
import matplotlib.pyplot as plt
import pandas as pd
import numpy as np

props = chart.get_properties()
utils.preconfigure_plot(props)

filter_expression = props["filter"]
include_fields = props.get("include_fields", "false") == "true"

try:
    df = results.get_scalars(
        filter_expression,
        include_fields=include_fields,
        include_attrs=True,
        include_runattrs=True,
        include_itervars=True
    )
except results.ResultQueryError as e:
    raise chart.ChartScriptError("Error while querying results: " + str(e))

if df.empty:
    raise chart.ChartScriptError("The result filter returned no data.")

df = df[df["name"].isin(["ReceivedBroadcasts", "SNIRLostPackets", "RXTXLostPackets", "TotalLostPackets"])]

pivot = df.pivot_table(
    index=["configname", "replication"],
    columns="name",
    values="value",
    aggfunc="mean"
).reset_index()

means = pivot.groupby("configname")[
    ["ReceivedBroadcasts", "SNIRLostPackets", "RXTXLostPackets"]
].mean().sort_index()


means["TotalLost"]     = means["SNIRLostPackets"] + means["RXTXLostPackets"]
means["TotalAttempts"] = means["ReceivedBroadcasts"] + means["TotalLost"]

means["% Received"]    = means["ReceivedBroadcasts"] / means["TotalAttempts"] * 100
means["% SNIR Lost"]   = means["SNIRLostPackets"]    / means["TotalAttempts"] * 100
means["% RXTX Lost"]   = means["RXTXLostPackets"]    / means["TotalAttempts"] * 100
means["SNIR Share of Lost (%)"] = means["SNIRLostPackets"] / means["TotalLost"] * 100


print("=" * 95)
print("Packet Fate Breakdown (Vehicles only)")
print("=" * 95)

summary = means[[
    "ReceivedBroadcasts", "SNIRLostPackets", "RXTXLostPackets", "TotalLost",
    "% Received", "% SNIR Lost", "% RXTX Lost", "SNIR Share of Lost (%)"
]].copy()

summary.columns = [
    "Received", "SNIR Lost", "RXTX Lost", "Total Lost",
    "% Received", "% SNIR", "% RXTX", "SNIR Share of Lost (%)"
]

print(summary.round(2).to_string())
print("=" * 95)


plt.close("all")
fig, ax = plt.subplots(figsize=(12, 5.8))

categories = list(means.index)
x = np.arange(len(categories))

received = means["% Received"].values
snir     = means["% SNIR Lost"].values
rxtx     = means["% RXTX Lost"].values

ax.bar(x, received, width=0.60, label="Received", color="#2ca02c")
ax.bar(x, snir,     width=0.60, bottom=received, label="SNIR Lost", color="#1f77b4")
ax.bar(x, rxtx,     width=0.60, bottom=received + snir, label="RXTX Lost", color="#ff7f0e")

ax.set_xticks(x)
ax.set_xticklabels(categories)
ax.set_xlim(-0.6, len(categories) - 0.4)

ax.set_ylabel("Percentage of Reception Attempts (%)")
ax.set_xlabel("Configuration")
ax.set_title("Packet Reception Outcome Breakdown")
ax.set_ylim(0, 100)


ax.legend(loc="upper center", ncol=3, framealpha=0.9)


fig.subplots_adjust(left=0.10, bottom=0.18, right=0.95, top=0.88)

props["yaxis_min"] = "0"
props["yaxis_max"] = "100"
utils.postconfigure_plot(props)

ax.set_ylim(0, 100)
ax.set_xlim(-0.6, len(categories) - 0.4)

utils.export_image_if_needed(props)
utils.export_data_if_needed(df, props)]]></script>
            <dialogPage id="INPUT" label="Input"><![CDATA[<?xml version="1.0" encoding="UTF-8"?>
<xswt xmlns:x="http://sweet_swt.sf.net/xswt">
  <import xmlns="http://sweet_swt.sf.net/xswt">
    <package name="java.lang" />
    <package name="org.eclipse.swt.widgets" />
    <package name="org.eclipse.swt.graphics" />
    <package name="org.eclipse.swt.layout" />
    <package name="org.eclipse.swt.custom" />
  </import>
  <layout x:class="GridLayout" numColumns="2" />
  <x:children>
    <label text="Filter expression:" >
        <layoutData x:class="GridData" horizontalSpan="2" horizontalAlignment="FILL" grabExcessHorizontalSpace="true"/>
    </label>

    <styledText x:id="filter" x:style="BORDER|V_SCROLL|H_SCROLL" x:id.contentAssist="filter" x:id.resultType="scalar">
      <layoutData x:class="GridData" horizontalSpan="2" horizontalAlignment="FILL" grabExcessHorizontalSpace="true" verticalAlignment="FILL" grabExcessVerticalSpace="true" />
    </styledText>
    
    <button x:id="include_fields" x:style="CHECK" text="Include fields">
      <layoutData x:class="GridData" horizontalAlignment="END" />
    </button>
    
    <button x:id="simplify" x:style="PUSH" text="Simplify" x:id.role="simplify" x:id.targetControl="filter">
      <layoutData x:class="GridData" horizontalAlignment="END" />
    </button>

    <label text="Multiple attributes can be selected in both fields below, separated by commas.">
        <layoutData x:class="GridData" horizontalSpan="2" horizontalAlignment="FILL" grabExcessHorizontalSpace="true"/>
    </label>

    <label text="Groups:"/>
    <combo x:id="groups" x:style="BORDER" x:id.content="module,name,experiment,module+name,$itervarnames,$runattrnames">
        <layoutData x:class="GridData" horizontalAlignment="FILL" grabExcessHorizontalSpace="true"/>
    </combo>

    <label text="Series:"/>
    <combo x:id="series" x:style="BORDER" x:id.content="module,name,experiment,module+name,$itervarnames,$runattrnames">
        <layoutData x:class="GridData" horizontalAlignment="FILL" grabExcessHorizontalSpace="true"/>
    </combo>

    <label text="Scalar values will be averaged across all attributes not selected above.">
        <layoutData x:class="GridData" horizontalSpan="2" horizontalAlignment="FILL" grabExcessHorizontalSpace="true"/>
    </label>

  </x:children>
</xswt>
]]></dialogPage>
            <dialogPage id="BARS" label="Bars"><![CDATA[<?xml version="1.0" encoding="UTF-8"?>
<xswt xmlns:x="http://sweet_swt.sf.net/xswt">

  <import xmlns="http://sweet_swt.sf.net/xswt">
    <package name="java.lang"/>
    <package name="org.eclipse.swt.widgets" />
    <package name="org.eclipse.swt.graphics" />
    <package name="org.eclipse.swt.layout" />
    <package name="org.eclipse.swt.custom" />
    <package name="org.omnetpp.common.wizard.support" />
    <package name="org.omnetpp.ned.editor.wizards.support" />
    <package name="org.omnetpp.cdt.wizard.support" />
  </import>
  <layout x:class="GridLayout"/>

  <x:children>

    <group text="Bars">
      <layoutData x:class="GridData" horizontalSpan="1" horizontalAlignment="FILL" grabExcessHorizontalSpace="true" verticalAlignment="FILL" grabExcessVerticalSpace="false"/>
      <layout x:class="GridLayout" numColumns="2"/>
      <x:children>

        <!-- Baseline -->
        <label text="Baseline:"/>
        <text x:id="baseline" x:id.default="0" x:style="BORDER">
          <layoutData x:class="GridData" horizontalAlignment="FILL" grabExcessHorizontalSpace="true"/>
        </text>

        <!-- Bar placement:Aligned/Overlap/InFront/Stacked -->
        <label text="Bar placement:"/>
        <combo x:id="bar_placement" x:id.default="Aligned" x:style="BORDER|READ_ONLY">
          <add x:p0="Aligned"/>
          <add x:p0="Overlap"/>
          <add x:p0="InFront"/>
          <add x:p0="Stacked"/>
        </combo>

        <!-- Rotate X labels by:0/30/45/60/90 -->
        <label text="Rotate x labels by:"/>
        <combo x:id="xlabel_rotation" x:id.default="0" x:style="BORDER|READ_ONLY">
          <add x:p0="0"/>
          <add x:p0="30"/>
          <add x:p0="45"/>
          <add x:p0="60"/>
          <add x:p0="90"/>
        </combo>

      </x:children>
    </group>

  </x:children>
</xswt>
]]></dialogPage>
            <dialogPage id="CONFINT" label="Confidence Interval"><![CDATA[<?xml version="1.0" encoding="UTF-8"?>
<xswt xmlns:x="http://sweet_swt.sf.net/xswt">

  <import xmlns="http://sweet_swt.sf.net/xswt">
    <package name="java.lang"/>
    <package name="org.eclipse.swt.widgets" />
    <package name="org.eclipse.swt.graphics" />
    <package name="org.eclipse.swt.layout" />
    <package name="org.eclipse.swt.custom" />
    <package name="org.omnetpp.common.wizard.support" />
    <package name="org.omnetpp.ned.editor.wizards.support" />
    <package name="org.omnetpp.cdt.wizard.support" />
